# ─── B.U.T.T. Base environment ────────────────────────────────
# Copy to .env.local (dashboard/gateway) or .env (provisioner).

# Dev mode: 1 = mock registry + accept any bearer token (no real Supabase needed)
BB_DEV_MODE=1

# Master Supabase project (control plane: auth + projects_registry + queue)
MASTER_SUPABASE_URL=
MASTER_SERVICE_ROLE_KEY=

# Supabase Management API (provisioning worker only)
SUPABASE_MANAGEMENT_PAT=
BB_DEFAULT_REGION=ap-south-1
PROVISION_MAX_PER_DAY=2

# Encryption key for node service keys at rest (AES-256-GCM)
# 32 bytes base64 — generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REGISTRY_ENCRYPTION_KEY=

# Gateway
GATEWAY_BASE_URL=http://localhost:8787

# Keep-alive cron guard (verify cron invocations)
CRON_SECRET=
